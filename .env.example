# Sibling catalog-value repo (MovieLens core + collaborative embeddings).
CATALOG_VALUE_ROOT=

# Optional: TMDB overviews as a silver narrative proxy.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Rotten Tomatoes critic/audience labels come from the GroupLens hetrec 2011
# snapshot (no API key). `ingest-rt` downloads it into data/raw/hetrec/.

# Local OpenJev scene judge (NLI System One: premise + hypothesis → probabilities).
# Default backend is auto: cached AlexWortega/openjev if present, else heuristic.
# OPENJEV_BACKEND=auto|openjev|heuristic
# OPENJEV_MODEL=AlexWortega/openjev
# OPENJEV_SUBFOLDER=qwen3.5-4b-nli
# OPENJEV_DOWNLOAD=0
# OPENJEV_MAX_SCENES=12
# OPENJEV_BATCH=4
